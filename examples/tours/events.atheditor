  "scripts": [
    {
      "name": "ThirdPersonController.js",
      "content": "// ThirdPersonController.js — generated by the Third Person template.\n//\n// ctx.player is this object's own state slot. The engine handles it reaches\n// are ctx.physics.bodies.player (the ODE body) and ctx.RenderObjects.player\n// (what is drawn).\n\nconst DEADZONE = 25;      // sticks rest near 0 but are never exactly 0\nconst STICK_MAX = 127.0;\n\n// The camera must stay off the poles: at 90 degrees the view vector lines up\n// with the camera's up vector and the look-at matrix has no horizon left.\nconst PITCH_MIN = -0.2;\nconst PITCH_MAX = 1.2;\n\n/** A stick axis as -1..1, with the rest position filtered out. */\nfunction axis(v) {\n    return (v > DEADZONE || v < -DEADZONE) ? Math.max(-1.0, Math.min(1.0, v / STICK_MAX)) : 0.0;\n}\n\nconst numberBuffer = new Float64Array(1);\nfunction number(value) { numberBuffer[0] = value; return numberBuffer[0]; }\n\nexport function init(ctx) {\n    const s = ctx.player;\n    s.yaw = 0.0;            // camera angle. 0 puts the camera on +Z, looking at -Z\n    s.pitch = 0.35;         // radians above the character\n    s.angle = Math.PI;      // model facing: PI points its +Z nose along world -Z\n    s.speed = 6.0;          // world units per second\n    s.turnRate = 12.0;      // how quickly the character swings around\n    s.lookRate = 2.4;       // radians per second at full stick\n    s.jumpSpeed = 5.2;\n    s.camDistance = 8.0;\n    s.camHeight = 1.5;      // where the camera looks, above the body centre\n    s.grounded = false;\n    s.coyote = 0.0;\n    s.jumpBuffer = 0.0;\n    s.jumping = false;\n    s.body = ctx.physics.bodies.player;\n    s.view = ctx.RenderObjects.player;\n    s.rotation = { x: 0.0, y: s.angle, z: 0.0 };\n    s.view.rotation = s.rotation;\n    s.cachedYaw = null; s.cachedPitch = null;\n    s.moveX = null; s.moveZ = null; s.wantAngle = s.angle;\n}\n\nexport function update(ctx, pad) {\n    const s = ctx.player;\n    const body = s.body;\n    const view = s.view;\n    const dt = Math.max(0.001, Math.min(0.05, ctx.dt || 0.016));\n    const p = body.getPosition();\n    const vel = body.getLinearVel();\n    let vy = number(vel[1]);\n\n    // ── grounded ────────────────────────────────────────────────────\n    // ode_onCollide stored the contact normal from the last step. Only its\n    // steepness is meaningful: ODE's normal points into whichever geom the\n    // broad phase called the first one, so the sign is not ours to rely on.\n    const n = s.lastHitNormal;\n    const hit = s.lastHitPosition;\n    s.grounded = !!n && Math.abs(n[1]) > 0.7 && (!hit || hit[1] < p[1]) && (!s.jumping || vy <= 0.0);\n    s.lastHitNormal = null;     // consume it, or one contact grounds you forever\n    if (s.grounded) s.jumping = false;\n    s.coyote = s.grounded ? 0.10 : Math.max(0.0, s.coyote - dt);\n    s.jumpBuffer = pad.justPressed(Pads.CROSS) ? 0.12 : Math.max(0.0, s.jumpBuffer - dt);\n\n    // ── swing the camera ────────────────────────────────────────────\n    // Turning right decreases yaw: forward is (-sin yaw, 0, -cos yaw), so\n    // world +X — the right-hand side of the screen — sits at yaw = -PI/2.\n    let turn = axis(pad.rx);\n    if (pad.pressed(Pads.L1)) turn = -1.0;   // fallback for a digital pad\n    if (pad.pressed(Pads.R1)) turn =  1.0;\n    s.yaw = number(s.yaw - turn * s.lookRate * dt);\n    if (s.yaw > Math.PI) s.yaw = number(s.yaw - Math.PI * 2.0);\n    if (s.yaw < -Math.PI) s.yaw = number(s.yaw + Math.PI * 2.0);\n    // pad.ry grows downwards (it is rjoy_v - 127), and pitch is the camera's\n    // elevation, so adding it means pushing the stick up drops the camera and\n    // aims the view upward — the same gesture as in first person.\n    s.pitch = number(s.pitch + axis(pad.ry) * s.lookRate * dt);\n    if (s.pitch > PITCH_MAX) s.pitch = PITCH_MAX;\n    if (s.pitch < PITCH_MIN) s.pitch = PITCH_MIN;\n\n    if (s.cachedYaw !== s.yaw) {\n        s.cachedYaw = s.yaw;\n        s.sinYaw = Math.sin(s.yaw); s.cosYaw = Math.cos(s.yaw);\n    }\n    const sy = s.sinYaw, cy = s.cosYaw;\n    const fx = -sy, fz = -cy;   // where the camera looks, flattened\n    const rx =  cy, rz = -sy;   // its right\n\n    // ── move, relative to the camera ────────────────────────────────\n    let ix = axis(pad.lx);\n    let iz = -axis(pad.ly);     // pad.ly grows downwards, so negate for \"forward\"\n    if (pad.pressed(Pads.LEFT))  ix = -1.0;\n    if (pad.pressed(Pads.RIGHT)) ix =  1.0;\n    if (pad.pressed(Pads.UP))    iz =  1.0;\n    if (pad.pressed(Pads.DOWN))  iz = -1.0;\n\n    // Clamp to the unit circle so diagonals are not faster.\n    const squared = number(ix * ix + iz * iz);\n    if (squared > 1.0) { const mag = Math.sqrt(squared); ix /= mag; iz /= mag; }\n\n    const mx = fx * iz + rx * ix;   // world direction of travel\n    const mz = fz * iz + rz * ix;\n\n    if (s.coyote > 0.0 && s.jumpBuffer > 0.0) {\n        vy = s.jumpSpeed;\n        s.coyote = s.jumpBuffer = 0.0;\n        s.grounded = false; s.jumping = true;\n    }\n    body.setLinearVel(mx * s.speed, vy, mz * s.speed);\n\n    // ── face the direction of travel ────────────────────────────────\n    // rotation.y = T sends the model's +Z axis to (sin T, cos T), so the angle\n    // that points its nose along (mx, mz) is atan2(mx, mz).\n    // Freeze Rotation keeps the solver from touching this.\n    if (squared > 0.0225) {\n        if (mx !== s.moveX || mz !== s.moveZ) {\n            s.moveX = mx; s.moveZ = mz; s.wantAngle = Math.atan2(mx, mz);\n        }\n        const want = s.wantAngle;\n        let delta = number(want - s.angle);\n        if (delta >  Math.PI) delta = number(delta - Math.PI * 2.0);\n        if (delta < -Math.PI) delta = number(delta + Math.PI * 2.0);\n        if (Math.abs(delta) > 0.001) {\n            s.angle = number(s.angle + delta * Math.min(1.0, s.turnRate * dt));\n            if (s.angle > Math.PI) s.angle = number(s.angle - Math.PI * 2.0);\n            if (s.angle < -Math.PI) s.angle = number(s.angle + Math.PI * 2.0);\n            s.rotation.y = s.angle;\n            view.rotation = s.rotation;\n        }\n    }\n\n    // ── camera ──────────────────────────────────────────────────────\n    // Straight back along the camera's own forward vector, lifted by pitch.\n    // Target BEFORE position: Camera.target() moves the camera by the same\n    // delta to preserve the view vector (setCameraTarget in src/camera.c), so\n    // calling it second would drag the position that was just set.\n    const tx = p[0], ty = p[1] + s.camHeight, tz = p[2];\n    if (s.cachedPitch !== s.pitch || s.cachedDistance !== s.camDistance) {\n        s.cachedPitch = s.pitch; s.cachedDistance = s.camDistance;\n        s.back = s.camDistance * Math.cos(s.pitch);\n        s.lift = s.camDistance * Math.sin(s.pitch);\n    }\n    const back = s.back;\n    Camera.target(tx, ty, tz);\n    Camera.position(tx - fx * back, ty + s.lift, tz - fz * back);\n}\n"
    }
  ],
